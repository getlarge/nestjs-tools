{
  "compileOnSave": false,
  "compilerOptions": {
    "sourceMap": true,
    "declaration": true,
    "moduleResolution": "nodenext",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2021",
    "module": "nodenext",
    "lib": ["es2020", "dom", "esnext.disposable"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "composite": true,
    "declarationMap": true,
    "customConditions": ["@getlarge/source"],
    "noEmitOnError": true,
    "esModuleInterop": true
  },
  "exclude": ["node_modules", "tmp"]
}
