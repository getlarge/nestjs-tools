{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "bundler",
    "outDir": "./out-tsc/jest",
    "types": ["jest", "node"],
    "rootDir": ".",
    "customConditions": null
  },
  "include": [
    "jest.config.ts",
    "src/**/*.mock.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.d.ts",
    "test/**/*.ts"
  ],
  "references": [
    {
      "path": "./tsconfig.lib.json"
    }
  ]
}
